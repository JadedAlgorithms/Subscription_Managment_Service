# ==============================================================================
# BRIGHTLOOP SUBSCRIPTION MANAGEMENT SYSTEM - ROOT ENVIRONMENT TEMPLATE
# ==============================================================================

# PostgreSQL Connection String (Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=<SCHEMA>)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/brightloop_subscriptions?schema=public"

# Backend Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# Security & Authentication
JWT_SECRET=brightloop-super-secure-production-ready-jwt-secret-key-32chars
JWT_EXPIRES_IN=7d

# Frontend Client URL (for CORS validation)
CLIENT_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:5000/api/v1

